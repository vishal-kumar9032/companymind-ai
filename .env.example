# FalkorDB Connection (Local or FalkorDB Cloud)
# For FalkorDB Cloud set FALKORDB_URL (redis(s)://user:pass@host:port); it overrides HOST/PORT.
FALKORDB_URL=
FALKORDB_HOST=localhost
FALKORDB_USERNAME=
FALKORDB_TLS=false
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=CompanyMind

# Enterprise AI Gateway (TrueFoundry / OpenAI compatible)
TRUEFOUNDRY_API_KEY=your_pat_or_api_key_here
TRUEFOUNDRY_BASE_URL=https://your-org.truefoundry.cloud/api/llm/v1
TRUEFOUNDRY_MODEL=google-gemini/gemini-3.1-flash-lite
TRUEFOUNDRY_FALLBACK_MODELS=groq/qwen-qwen3.8-27b,groq/openai-gpt-oss-20b,google-gemini/gemini-2.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Authentication & Firestore (Optional)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_ENABLE_FIRESTORE=false

# Composio (Gmail, Calendar, Drive, Sheets, GitHub connectors)
COMPOSIO_API_KEY=
ALLOW_DEMO_RESEED=false
